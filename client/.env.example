# ============================================================
# Frontend environment variables — copy to `.env.local` and fill in.
# NEXT_PUBLIC_* values are compiled into the browser bundle:
#   - Only publishable/ANON keys belong here.
#   - NEVER put the Supabase service-role key or the OpenAI API key here.
# ============================================================

# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Backend API base URL (server/.env PORT must match)
NEXT_PUBLIC_API_URL=http://localhost:3001/api
