# ============================================================
# Backend environment variables — copy to `.env` and fill in.
# Never commit the real `.env` file (it is gitignored).
# ============================================================

# --- Express -------------------------------------------------
PORT=3001
NODE_ENV=development

# Comma-separated list of origins allowed by CORS.
# Secure default when unset: http://localhost:3000
# Set explicitly for deployments, e.g.: https://yourdomain.com
# Use * only if you fully understand the implications.
CORS_ORIGIN=http://localhost:3000

# --- Supabase (required) -------------------------------------
# Project Settings -> API -> Project URL
SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings -> API -> anon / publishable key.
# The server uses this key together with each request's user JWT, so
# Row Level Security is enforced on every query. This is a PUBLIC key
# (safe in frontend code) — it must NOT be a secret key.
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Supabase (optional, NOT used by the API server) ---------
# Service-role key. The request-handling code never uses it; it is only
# read by `createAdminClient()` for offline admin/data-repair scripts.
# Leave unset for normal operation.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- OpenAI (required) ---------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Frontend counterpart (documented here for reference) ----
# The Next.js client needs these NEXT_PUBLIC_* values in client/.env.local:
#   NEXT_PUBLIC_SUPABASE_URL=<same project URL>
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<same anon/publishable key>
#   NEXT_PUBLIC_API_URL=http://localhost:3001/api
