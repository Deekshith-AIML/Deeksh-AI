# ============================================================
# Backend environment variables — copy to `.env` and fill in.
# Never commit the real `.env` file (it is gitignored).
# ============================================================

# --- Express -------------------------------------------------
PORT=3001
NODE_ENV=development

# Comma-separated list of origins allowed by CORS.
# Secure default when unset: http://localhost:3000
# Set explicitly for deployments, e.g.: https://yourdomain.com
# Use * only if you fully understand the implications.
CORS_ORIGIN=http://localhost:3000

# --- Supabase (required) -------------------------------------
# Project Settings -> API -> Project URL
SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings -> API -> anon / publishable key.
# The server uses this key together with each request's user JWT, so
# Row Level Security is enforced on every query. This is a PUBLIC key
# (safe in frontend code) — it must NOT be a secret key.
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Supabase service role (required for the WORKER process) --
# The Express API never reads this key: every request uses the caller's
# JWT + the anon key, so RLS stays enforced. It is REQUIRED by the
# separate background worker (`npm run worker`), which claims reminder and
# memory-extraction jobs across all users and writes delivery/extraction
# status — operations RLS-scoped clients cannot perform.
# Treat it as a SECRET: server-side only, never NEXT_PUBLIC_*, never logged.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Google Gemini (required) --------------------------------
# Google AI Studio -> "Get API key". Used via Gemini's OpenAI-compatible
# endpoint (https://generativelanguage.googleapis.com/v1beta/openai/).
# The server authenticates with `Authorization: Bearer <GEMINI_API_KEY>`.
# Keep this key SERVER-SIDE ONLY: never expose it via NEXT_PUBLIC_*
# variables or ship it to the browser.
GEMINI_API_KEY=AIza...
# Optional. Defaults to `gemini-3.8-flash` when unset.
GEMINI_MODEL=gemini-3.8-flash
# Optional. Override the OpenAI-compatible base URL (regional endpoints
# or a local mock server). Defaults to the public Gemini endpoint above.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Embeddings (Milestone 4.1 — memory semantic search) ------
# Active embedding provider for the memory index: gemini | ollama.
# The searchable memory index (vector(1536)) is locked to ONE embedding
# space at a time. Switching providers requires a controlled re-embedding
# migration or an isolated index — vectors are never padded/truncated.
EMBEDDING_PROVIDER=gemini
# Gemini embedding model. Leave EMPTY to use the default
# `gemini-embedding-2` (official embedContent endpoint; output_dimensionality
# 1536 is requested explicitly because the model defaults to 3072).
GEMINI_EMBEDDING_MODEL=
# Embeddings authenticate with the GEMINI_API_KEY above (same key, dedicated
# `POST /v1beta/models/{model}:embedContent` endpoint — key sent in the
# `x-goog-api-key` header, never in the URL).
#
# Ollama — LOCAL, ISOLATED evaluation only. `embeddinggemma` outputs 768
# dims: a DIFFERENT vector space than the 1536-dim production index, so its
# vectors are never mixed into production memory records. To evaluate it:
#   1) install:  ollama pull embeddinggemma
#   2) set:      EMBEDDING_PROVIDER=ollama
#   3) run:      npm run smoke:embeddings:ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=embeddinggemma
# Optional. Per-request timeout override in ms. Provider defaults:
# Gemini 30_000 (warm cloud API), Ollama 120_000 (cold model load ~40-55s).
# EMBEDDING_TIMEOUT_MS=
# Optional. Repeat-consistency threshold for the live embedding smoke test.
# SMOKE_CONSISTENCY_THRESHOLD=0.98

# NOTE: OPENAI_API_KEY / OPENAI_MODEL are no longer read by the server.

# --- Reminders / email (Milestone 2, optional) ---------------
# Resend API key (server-side ONLY — never expose via NEXT_PUBLIC_*).
# https://app.resend.com/api-keys
RESEND_API_KEY=
# Verified sender identity, e.g. "TaskMate <reminders@yourdomain.com>".
# In Resend: Domains -> verify your domain, then create a sender.
RESEND_FROM_EMAIL=
# Public base URL embedded in reminder emails (frontend origin).
APP_BASE_URL=http://localhost:3000
# When RESEND_API_KEY / RESEND_FROM_EMAIL are unset, the scheduler uses a
# mock provider and NO emails are actually delivered (a warning is logged).

# --- Reminder scheduler (Milestone 2) -------------------------
# The scheduler runs as a SEPARATE process:  npm run worker
# It REQUIRES SUPABASE_SERVICE_ROLE_KEY (see the Supabase section above)
# because it must claim due reminders across all users and record delivery
# status. Migration 0010 grants that role the minimum privileges it needs.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Frontend counterpart (documented here for reference) ----
# The Next.js client needs these NEXT_PUBLIC_* values in client/.env.local:
#   NEXT_PUBLIC_SUPABASE_URL=<same project URL>
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<same anon/publishable key>
#   NEXT_PUBLIC_API_URL=http://localhost:3001/api
