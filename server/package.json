{
  "name": "ai-task-assistant-server",
  "version": "1.0.0",
  "description": "Backend for the AI-powered Task Assistant (Express + Supabase + Gemini via OpenAI-compatible API)",
  "main": "dist/server/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx src/worker.ts",
    "worker:dev": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/src/server.js",
    "start:worker": "node dist/server/src/worker.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:embeddings": "tsx scripts/embedding-smoke.ts",
    "smoke:embeddings:gemini": "tsx scripts/embedding-smoke.ts --provider=gemini",
    "smoke:embeddings:ollama": "tsx scripts/embedding-smoke.ts --provider=ollama"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "@types/pg": "^8.23.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "openai": "^4.68.0",
    "pg": "^8.23.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^5.0.5"
  }
}
